# Backend environment variables
# Copy this file to .env and fill in the values for local development.
# For production (Render), set these in the Render dashboard.

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset for SQLite (local dev). Set to Neon pooled connection string for production.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── File storage (S3-compatible) ────────────────────────────────────────────
# Option A — Backblaze B2 (no card required, free 10 GB):
# STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# R2_ACCESS_KEY=your_b2_keyID
# R2_SECRET_KEY=your_b2_applicationKey
# R2_BUCKET=DMITobjects
# R2_PUBLIC_URL=   (leave blank — bucket is private, presigned URLs are used)

# Option B — Cloudflare R2 (requires card but global CDN):
# CF_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY=your_r2_access_key
# R2_SECRET_KEY=your_r2_secret_key
# R2_BUCKET=dmit-files
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Authentication ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@dmit.local
ADMIN_PASSWORD=changeme123
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_32_byte_hex_string

# ── AI providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBED_KEY=your_nvidia_embed_key_here

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here after deploying:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Environment ─────────────────────────────────────────────────────────────
# Set to "production" on Render to enable Secure cookies.
# ENVIRONMENT=production
# PYTHONOPTIMIZE=1
